# ── TollAI Monitor — Environment Configuration ────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=toll_monitoring
DB_USER=toll_user
DB_PASSWORD=your_strong_password_here

# ── Application ───────────────────────────────────────────────
PORT=5002
SECRET_KEY=change_this_to_a_random_64_char_string

# ── AI Engine ─────────────────────────────────────────────────
# Recommended: yolov8s.pt (balanced) | yolov8m.pt (high accuracy + GPU)
YOLO_MODEL=yolov8s.pt

# ── Camera Sources ────────────────────────────────────────────
# Dahua IP Camera @ 10.10.10.99
# Main stream (1080p):  channel=1&subtype=0
# Sub stream  (720p):   channel=1&subtype=1  (less CPU usage)
CAM1_SOURCE=rtsp://admin:admin123@10.10.10.99:554/cam/realmonitor?channel=1&subtype=0
CAM2_SOURCE=0
